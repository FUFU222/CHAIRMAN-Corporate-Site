---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteScript from "../scripts/site.js?url";
import { absoluteUrl } from "../lib/format";
import { withBase } from "../lib/links";
import { site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  pathname?: string;
  image?: string;
  noIndex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  pathname = "/",
  image = "/og-default.png",
  noIndex = false,
  schema = [],
  bodyClass = ""
} = Astro.props;

const pageTitle = pathname === "/" ? `${title} | ${site.name}` : `${title} | ${site.name}`;
const canonical = absoluteUrl(pathname, site.siteUrl);
const socialImage = image.startsWith("http") ? image : absoluteUrl(image, site.siteUrl);
const schemaItems = Array.isArray(schema) ? schema : [schema];
const gaId = import.meta.env.PUBLIC_GA_ID;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/assets/favicon-16x16.ico", base)} sizes="16x16" type="image/x-icon" />
    <link rel="icon" href={withBase("/assets/favicon-24x24.ico", base)} sizes="24x24" type="image/x-icon" />
    <link rel="icon" href={withBase("/assets/favicon-32x32.ico", base)} sizes="32x32" type="image/x-icon" />
    <link rel="icon" href={withBase("/assets/favicon-48x48.ico", base)} sizes="48x48" type="image/x-icon" />
    <link rel="icon" href={withBase("/assets/favicon-64x64.ico", base)} sizes="64x64" type="image/x-icon" />
    <link rel="icon" href={withBase("/assets/favicon-128x128.ico", base)} sizes="128x128" type="image/x-icon" />
    <link rel="icon" href={withBase("/assets/favicon-256x256.ico", base)} sizes="256x256" type="image/x-icon" />
    <link rel="apple-touch-icon" href={withBase("/assets/favicon-180x180.png", base)} sizes="180x180" />
    <link rel="alternate" href={withBase("/llms.txt", base)} type="text/plain" title="LLMs.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@500;700&display=swap"
    />
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline>
          {`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '${gaId}');
          `}
        </script>
      </>
    )}
    {schemaItems.filter(Boolean).map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)}></script>
    ))}
  </head>
  <body class={bodyClass}>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <script type="module" src={siteScript}></script>
  </body>
</html>
