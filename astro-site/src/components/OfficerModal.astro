---
import modalScript from "../scripts/officer-modal.js?url";
import type { Officer } from "../lib/types";

interface Props {
  officers: Officer[];
}

const { officers } = Astro.props;
---

<section class="officers">
  <div class="officers__grid">
    {officers.map((officer) => (
      <article
        class="officer-card"
        data-officer-card
        data-name={officer.name}
        data-role={officer.role}
        data-role-detail={officer.roleDetail ?? ""}
        data-summary={officer.summary}
        data-details={JSON.stringify(officer.details)}
        data-image={officer.image.src}
        data-note-url={officer.noteUrl ?? ""}
      >
        <button type="button" data-officer-open>
          <span class="officer-card__media">
            <img
              src={officer.image.src}
              alt={officer.name}
              width={officer.image.width}
              height={officer.image.height}
              sizes="(max-width: 960px) 100vw, 28vw"
              loading="lazy"
            />
          </span>
          <span class="officer-card__text">
            <span class="officer-card__role">{officer.role}</span>
            <strong>{officer.name}</strong>
            <span>{officer.summary}</span>
          </span>
        </button>
      </article>
    ))}
  </div>

  <dialog class="officer-dialog" data-officer-dialog aria-labelledby="officer-dialog-title">
    <div class="officer-dialog__panel">
      <button class="officer-dialog__close" type="button" data-officer-close aria-label="閉じる">
        閉じる
      </button>
      <div class="officer-dialog__media">
        <img src="" alt="" width="720" height="900" data-officer-image />
      </div>
      <div class="officer-dialog__body">
        <p class="officer-dialog__role" data-officer-role></p>
        <p class="officer-dialog__role-detail" data-officer-role-detail></p>
        <h3 id="officer-dialog-title" data-officer-name></h3>
        <p class="officer-dialog__summary" data-officer-summary></p>
        <div class="officer-dialog__details" data-officer-details></div>
        <a class="text-link" href="#" target="_blank" rel="noopener noreferrer" data-officer-note hidden>
          noteを読む
        </a>
      </div>
    </div>
  </dialog>
</section>

<script is:inline type="module" src={modalScript}></script>
