---
import type { ImageMetadata } from "astro";
import { withBase } from "../lib/links";

interface HeroSlide {
  image: ImageMetadata;
  alt?: string;
}

interface Props {
  title: string;
  lead: string;
  slides: HeroSlide[];
}

const { title, lead, slides } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="site-shell site-shell--wide hero__inner">
    <div class="hero__copy">
      <h1 set:html={title}></h1>
      <p class="hero__lead">{lead}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={withBase("/about-us/", base)}>
          私たちについて
        </a>
        <a class="button button--secondary" href={withBase("/contact/", base)}>
          ご相談・お問い合わせ
        </a>
      </div>
    </div>

    <div class="hero__visual">
      <figure class="hero__figure">
        <div class="hero__slides">
          {slides.map((slide, index) => (
            <span class={`hero__slide ${index === 0 ? "is-active" : ""}`} aria-hidden={index === 0 ? "false" : "true"}>
              <img
                src={slide.image.src}
                alt={index === 0 ? slide.alt ?? "" : ""}
                width={slide.image.width}
                height={slide.image.height}
                sizes="(max-width: 820px) 100vw, 56vw"
                loading={index === 0 ? "eager" : "eager"}
                fetchpriority={index === 0 ? "high" : "low"}
                decoding="async"
              />
            </span>
          ))}
        </div>
      </figure>
    </div>
  </div>
</section>
