---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";

const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || "";
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || "";

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "お問い合わせ",
  url: "https://chairman-official.com/contact/",
  description:
    "株式会社CHAIRMANへのお問い合わせページです。SNS運用、映像制作、越境EC、自治体連携、ブランド支援に関するご相談を受け付けています。"
};
---

<BaseLayout
  title="お問い合わせ"
  description="株式会社CHAIRMANへのお問い合わせページです。SNS運用、映像制作、越境EC、自治体連携、ブランド支援に関するご相談を受け付けています。"
  pathname="/contact/"
  schema={schema}
  bodyClass="page-contact"
>
  <section class="page-hero page-hero--narrow">
    <div class="site-shell page-hero__inner page-hero__inner--single">
      <div class="page-hero__copy" data-reveal>
        <p class="section-heading__eyebrow">CONTACT</p>
        <h1>お問い合わせ</h1>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="site-shell">
      <ContactForm endpoint={endpoint} recaptchaSiteKey={recaptchaSiteKey} contactEmail={site.contactEmail} />
    </div>
  </section>
</BaseLayout>
