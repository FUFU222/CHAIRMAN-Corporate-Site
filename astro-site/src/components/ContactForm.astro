---
import { contactCategories } from "../data/site";
import contactFormScript from "../scripts/contact-form.js?url";

interface Props {
  endpoint?: string;
  recaptchaSiteKey?: string;
}

const { endpoint = "", recaptchaSiteKey = "" } = Astro.props;
---

<section class="contact-form-block" data-contact-form-wrapper>
  <div class="contact-form-block__intro" data-reveal>
    <h2>お問い合わせ内容を確認のうえ、<br />担当よりご返信します。</h2>
    <ul class="contact-form-block__notes">
      <li>通常3営業日以内にご返信します。</li>
      <li>営業目的のご連絡は内容により返信できない場合があります。</li>
    </ul>
  </div>

  <div class="contact-form-block__panel" data-reveal>
    <form
      class="contact-form"
      method="POST"
      action={endpoint || "#"}
      target="contact-submit-target"
      novalidate
      data-contact-form
      data-endpoint={endpoint}
    >
      <div class="contact-form__grid">
        <label>
          <span>お名前</span>
          <input name="name" type="text" autocomplete="name" maxlength="80" required />
        </label>
        <label>
          <span>メールアドレス</span>
          <input
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            autocapitalize="off"
            spellcheck="false"
            maxlength="254"
            required
          />
        </label>
      </div>

      <div class="contact-form__grid">
        <label>
          <span>電話番号</span>
          <input
            name="phone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            maxlength="32"
            pattern="[0-9()+\\-. ]{6,32}"
          />
        </label>
        <label>
          <span>問い合わせ種別</span>
          <select name="category" required>
            <option value="">選択してください</option>
            {contactCategories.map((category) => (
              <option value={category}>{category}</option>
            ))}
          </select>
        </label>
      </div>

      <label>
        <span>本文</span>
        <textarea name="message" rows={8} minlength="10" maxlength="2000" required></textarea>
      </label>

      <label class="contact-form__honeypot" aria-hidden="true">
        <span>会社名</span>
        <input name="company" type="text" tabindex="-1" autocomplete="off" />
      </label>

      <input name="source" type="hidden" value="chairman-astro-site" />
      <input name="jsEnabled" type="hidden" value="0" />
      <input name="submittedAt" type="hidden" value="" />
      <input name="g-recaptcha-response" type="hidden" value="" data-recaptcha-response />

      <div class="contact-form__captcha-block">
        {recaptchaSiteKey ? (
          <div
            class="contact-form__captcha"
            data-recaptcha
            data-sitekey={recaptchaSiteKey}
            aria-label="reCAPTCHA によるボット対策"
          ></div>
        ) : (
          <p class="contact-form__captcha-note">
            reCAPTCHA の設定後にボット対策が有効になります。
          </p>
        )}
      </div>

      <div class="contact-form__actions">
        <button class="button button--primary" type="submit" data-contact-submit>
          送信する
        </button>
        <p class="contact-form__status" data-contact-status>
          入力内容を確認のうえ送信してください。
        </p>
      </div>
    </form>

    <iframe
      title="contact submission target"
      name="contact-submit-target"
      class="contact-form__target"
      hidden
      data-contact-target
    ></iframe>
  </div>
</section>

<script is:inline type="module" src={contactFormScript}></script>
