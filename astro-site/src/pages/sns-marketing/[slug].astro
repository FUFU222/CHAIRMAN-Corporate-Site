---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import NewsList from "../../components/NewsList.astro";
import ArticleShare from "../../components/ArticleShare.astro";
import { absoluteUrl, formatDateJP } from "../../lib/format";
import { withBase } from "../../lib/links";
import {
  getArticleHeroImage,
  getEnhancedArticleContentHtml
} from "../../lib/article-enhancements";
import { getKnowhowArticles } from "../../lib/article-groups";
import { getRelatedNews } from "../../lib/news";
import { getMicrocmsArticles } from "../../lib/microcms";

export async function getStaticPaths() {
  const articles = getKnowhowArticles(await getMicrocmsArticles());
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article, articles }
  }));
}

const { article, articles } = Astro.props;
const relatedArticles = getRelatedNews(articles, article, 3);
const articleUrl = absoluteUrl(`/sns-marketing/${article.slug}/`, "https://chairman-official.com");
const base = import.meta.env.BASE_URL;
const heroImage = getArticleHeroImage(article);
const articleContentHtml = getEnhancedArticleContentHtml(article);

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  datePublished: article.publishedAt,
  author: {
    "@type": "Person",
    name: article.author.name
  },
  mainEntityOfPage: articleUrl,
  description: article.description
};
---

<BaseLayout
  title={article.title}
  description={article.description || article.excerpt}
  pathname={`/sns-marketing/${article.slug}/`}
  image={heroImage?.src}
  socialImageAlt={heroImage?.alt || article.title}
  ogType="article"
  publishedTime={article.publishedAt}
  schema={schema}
  bodyClass="page-article"
>
  <article class="article">
    <header class="article__hero">
      <div class="site-shell article__hero-inner">
        <div class="article__copy" data-reveal>
          <p class="article__meta">
            <time datetime={article.publishedAt}>{formatDateJP(article.publishedAt)}</time>
            <span>{article.categories.map((category) => category.name).join(" / ")}</span>
          </p>
          <h1>{article.title}</h1>
          <p>{article.description || article.excerpt}</p>
        </div>
        {heroImage && (
          <figure class="article__hero-visual" data-reveal>
            <img
              src={heroImage.src}
              alt={heroImage.alt}
              width={heroImage.width}
              height={heroImage.height}
              sizes="(max-width: 960px) 100vw, 920px"
              loading="eager"
              decoding="async"
            />
          </figure>
        )}
      </div>
    </header>

    <div class="site-shell article__content">
      <div class="article__main">
        <div class="rich-text" set:html={articleContentHtml}></div>
        <ArticleShare title={article.title} url={articleUrl} />
        <div class="article__support" data-reveal>
          <section class="author-card author-card--author">
            <p class="section-heading__eyebrow">AUTHOR</p>
            <div class="author-card__profile">
              {article.author.image && (
                typeof article.author.image === "string" ? (
                  <img src={article.author.image} alt={article.author.name} width="320" height="320" loading="lazy" />
                ) : (
                  <img
                    src={article.author.image.src}
                    alt={article.author.name}
                    width={article.author.image.width}
                    height={article.author.image.height}
                    sizes="112px"
                    loading="lazy"
                  />
                )
              )}
              <div class="author-card__profile-copy">
                <h2>{article.author.name}</h2>
                <p class="author-card__role">{article.author.title}</p>
              </div>
            </div>
            <p>{article.author.bio}</p>
          </section>
          <section class="author-card author-card--contact">
            <p class="section-heading__eyebrow">CONTACT</p>
            <h2>ご相談はこちら</h2>
            <p>記事に関するご質問や、SNS運用のご相談はお問い合わせページから受け付けています。</p>
            <a class="button button--secondary" href={withBase("/contact/", base)}>
              お問い合わせ
            </a>
          </section>
        </div>
      </div>
    </div>
  </article>

  {relatedArticles.length > 0 && (
    <section class="page-section">
      <div class="site-shell related-section related-section--single" data-reveal>
        <div>
          <SectionHeading eyebrow="RELATED" title="関連記事" />
          <NewsList articles={relatedArticles} variant="stack" articleBasePath="/sns-marketing/" />
        </div>
      </div>
    </section>
  )}
</BaseLayout>
