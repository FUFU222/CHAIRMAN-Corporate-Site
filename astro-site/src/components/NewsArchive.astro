---
import type { NewsArticle } from "../lib/types";
import { formatDateJP } from "../lib/format";
import { withBase } from "../lib/links";
import { getArticleListImage } from "../lib/article-enhancements";
import archiveScript from "../scripts/news-archive.js?url";

interface Props {
  articles: NewsArticle[];
  articleBasePath?: string;
  showHeroImages?: boolean;
  initialVisibleCount?: number;
  loadMoreThreshold?: number;
  mobileFilterSelect?: boolean;
}

const {
  articles,
  articleBasePath = "/news/",
  showHeroImages = false,
  initialVisibleCount = 9,
  loadMoreThreshold = initialVisibleCount + 1,
  mobileFilterSelect = false
} = Astro.props;
const base = import.meta.env.BASE_URL;
const categories = Array.from(
  new Map(
    articles.flatMap((article) => article.categories).map((category) => [category.id, category])
  ).values()
);
const shouldRenderLoadMore = articles.length >= loadMoreThreshold;

function articleHref(slug: string) {
  return withBase(`${articleBasePath}${slug}/`, base);
}
---

<section
  class:list={["news-archive", mobileFilterSelect && "news-archive--mobile-select"]}
  data-news-archive
  data-page-size={initialVisibleCount}
  data-load-more-threshold={loadMoreThreshold}
>
  <div class="news-archive__toolbar" data-reveal>
    <div class="news-archive__filters" role="toolbar" aria-label="カテゴリ絞り込み">
      <button class="is-active" type="button" data-filter="all" aria-pressed="true">
        すべて
      </button>
      {categories.map((category) => (
        <button type="button" data-filter={category.id} aria-pressed="false">
          {category.name}
        </button>
      ))}
    </div>
    {mobileFilterSelect && (
      <label class="news-archive__select-field">
        <span class="visually-hidden">カテゴリを選択</span>
        <select class="news-archive__select" data-filter-select aria-label="カテゴリ絞り込み">
          <option value="all">すべて</option>
          {categories.map((category) => (
            <option value={category.id}>{category.name}</option>
          ))}
        </select>
      </label>
    )}
  </div>

  <div class="news-archive__list">
    {articles.map((article, index) => {
      const heroImage = showHeroImages ? getArticleListImage(article) : null;

      return (
        <article
          class="news-archive__item"
          data-archive-item
          data-categories={article.categories.map((category) => category.id).join(",")}
          data-index={index}
        >
          {heroImage ? (
            <a href={articleHref(article.slug)} class="news-archive__link news-archive__link--visual">
              <span class="news-archive__visual">
                <img
                  src={heroImage.src}
                  alt={heroImage.alt}
                  width={heroImage.width}
                  height={heroImage.height}
                  sizes="(max-width: 820px) 100vw, 340px"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="news-archive__body">
                <span class="news-archive__meta">
                  <time datetime={article.publishedAt}>{formatDateJP(article.publishedAt)}</time>
                  <span>{article.categories.map((category) => category.name).join(" / ")}</span>
                </span>
                <h2>{article.title}</h2>
                <span class="news-archive__excerpt">{article.excerpt}</span>
              </span>
            </a>
          ) : (
            <a href={articleHref(article.slug)} class="news-archive__link">
              <div>
                <p class="news-archive__meta">
                  <time datetime={article.publishedAt}>{formatDateJP(article.publishedAt)}</time>
                  <span>{article.categories.map((category) => category.name).join(" / ")}</span>
                </p>
                <h2>{article.title}</h2>
              </div>
              <p>{article.excerpt}</p>
            </a>
          )}
        </article>
      );
    })}
  </div>

  {shouldRenderLoadMore && (
    <div class="news-archive__actions">
      <button class="button button--secondary" type="button" data-load-more>
        さらに表示
      </button>
    </div>
  )}
</section>

<script is:inline type="module" src={archiveScript}></script>
