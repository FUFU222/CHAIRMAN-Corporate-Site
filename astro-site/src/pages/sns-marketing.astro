---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsArchive from "../components/NewsArchive.astro";
import { getKnowhowArticles } from "../lib/article-groups";
import { getMicrocmsArticles } from "../lib/microcms";

const archiveArticles = getKnowhowArticles(await getMicrocmsArticles());

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "SNSノウハウ集",
  url: "https://chairman-official.com/sns-marketing/",
  description:
    "株式会社CHAIRMANが発信するSNS運用・発信設計・動画活用のノウハウ記事一覧です。企業や地域ブランドの情報発信に役立つ実践知をまとめています。"
};
---

<BaseLayout
  title="SNSノウハウ集"
  description="株式会社CHAIRMANが発信するSNS運用・発信設計・動画活用のノウハウ記事一覧です。企業や地域ブランドの情報発信に役立つ実践知をまとめています。"
  pathname="/sns-marketing/"
  noIndex
  schema={schema}
  bodyClass="page-sns-marketing"
>
  <section class="page-hero page-hero--narrow">
    <div class="site-shell page-hero__inner page-hero__inner--single">
      <div class="page-hero__copy" data-reveal>
        <p class="section-heading__eyebrow">SNS KNOW-HOW</p>
        <h1>SNSノウハウ集</h1>
      </div>
    </div>
  </section>

  <section class="page-section page-section--tone">
    <div class="site-shell">
      {archiveArticles.length > 0 ? (
        <div class="sns-marketing__articles">
          <NewsArchive
            articles={archiveArticles}
            articleBasePath="/sns-marketing/"
            showHeroImages
            mobileFilterSelect
          />
        </div>
      ) : (
        <p class="sns-marketing__empty" data-reveal>
          公開中の記事はまだありません。
        </p>
      )}
    </div>
  </section>
</BaseLayout>
