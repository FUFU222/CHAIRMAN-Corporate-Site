---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import NewsList from "../components/NewsList.astro";
import heroLivaponImage from "../assets/images/service_livapon_card.webp";
import heroSnsImage from "../assets/images/service_sns_card.webp";
import heroKosolifeImage from "../assets/images/service_kosolife.webp";
import { businesses, companyFacts, homeRoles, site } from "../data/site";
import { withBase } from "../lib/links";
import { getLatestNews, getNewsArticles } from "../lib/microcms";

const articles = await getNewsArticles();
const latestNews = getLatestNews(articles, 3);
const base = import.meta.env.BASE_URL;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.name,
    url: site.siteUrl,
    logo: `${site.siteUrl}/og-default.png`,
    description: site.description
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.siteUrl
  }
];
---

<BaseLayout
  title="価値に、伝わる力を。"
  description={site.description}
  pathname="/"
  schema={schema}
  bodyClass="page-home"
>
  <Hero
    signature="CHAIRMAN"
    title={
      "<span class='hero__title-line hero__title-line--solid'>価値に、伝わる力を。</span>"
    }
    slides={[
      { image: heroLivaponImage, alt: "日本の価値を市場へつなぐ事業イメージ" },
      { image: heroSnsImage },
      { image: heroKosolifeImage }
    ]}
  />

  <section
    class="page-section page-section--about page-section--outline page-section--outline-left"
    data-outline-word="ABOUT"
  >
    <div class="site-shell home-about">
      <div class="home-about__intro">
        <header class="section-heading section-heading--left" data-reveal>
          <p class="section-heading__eyebrow">ABOUT CHAIRMAN</p>
          <h2>
            <span class="section-heading__line">価値を見つけ、</span>
            <span class="section-heading__line">伝わる形に</span>
            <span class="section-heading__line">届ける</span>
          </h2>
        </header>
      </div>
      <div class="role-grid">
        {homeRoles.map((role) => (
          <article class="role-card" data-reveal>
            <p>{role.label}</p>
            <h3>{role.title}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    class="page-section page-section--tone page-section--outline page-section--outline-right"
    data-outline-word="NEWS"
  >
    <div class="site-shell">
      <SectionHeading
        eyebrow="NEWS"
        title="新着情報"
        intro="事業のお知らせ、取り組み、公開情報を整理してお届けします。"
      />
      <NewsList articles={latestNews} />
      <div class="section-actions" data-reveal>
        <a class="text-link" href={withBase("/news/", base)}>
          バックナンバーを見る
        </a>
      </div>
    </div>
  </section>

  <section class="page-section" id="business">
    <div class="site-shell">
      <SectionHeading
        eyebrow="BUSINESS"
        title="主役は、地域価値を市場へ届ける事業設計です。"
        intro="LIVAPONを軸に、発信、販売、運営の各機能を一体で実装しています。"
      />
      <div class="business-stack">
        {businesses.map((business, index) => (
          <article class={`business-row ${index % 2 ? "business-row--reverse" : ""}`} data-reveal>
            <div class="business-row__media">
              <img
                src={business.image.src}
                alt={business.title}
                width={business.image.width}
                height={business.image.height}
                sizes="(max-width: 960px) 100vw, 34vw"
                loading="lazy"
              />
            </div>
            <div class="business-row__copy">
              <p>{business.label}</p>
              <h3>{business.title}</h3>
              <p>{business.summary}</p>
              <a class="text-link" href={business.href} target="_blank" rel="noopener">
                {business.linkLabel}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section page-section--company">
    <div class="site-shell company-grid">
      <div>
        <SectionHeading
          eyebrow="COMPANY"
          title="会社概要"
        />
      </div>
      <dl class="company-facts" data-reveal>
        {companyFacts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="page-section" id="representative-note">
    <div class="site-shell founder-note">
      <div data-reveal>
        <p class="section-heading__eyebrow">REPRESENTATIVE'S NOTE</p>
        <h2>{site.representativeNote.title}</h2>
        <p>{site.representativeNote.description}</p>
      </div>
      <div class="founder-note__actions" data-reveal>
        {site.representativeNote.href ? (
          <a
            class="button button--secondary"
            href={site.representativeNote.href}
            target="_blank"
            rel="noopener"
          >
            noteを読む
          </a>
        ) : (
          <span class="status-chip" aria-label="代表の備忘録は公開準備中です">
            {site.representativeNote.statusLabel}
          </span>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
